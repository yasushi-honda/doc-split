# DocSplit 開発環境
# gcloud config: doc-split
CLIENT_NAME="dev"
PROJECT_ID="doc-split-dev"
GCLOUD_CONFIG="doc-split"
EXPECTED_ACCOUNT="hy.unimail.11@gmail.com"
AUTH_TYPE="personal"
STORAGE_BUCKET="doc-split-dev.firebasestorage.app"

# Issue #445 PR-D4 S1-6: provenance backfill 用設定 (S1-7 で artifact bucket / Cloud Run Job runtime SA 等 provision)
ARTIFACT_BUCKET="doc-split-dev-pr-d4-artifacts"
CLOUD_RUN_LOCATION="asia-northeast1"
BUCKET_LOCATION="asia-northeast1"

# ADR-0025 PR4b: PaddleOCR Cloud Runサービス初回デプロイ後、.github/workflows/deploy-paddle-ocr.yml
# のSummaryに出力される実URLへ手動で更新すること(ワークフロー自体は書き込まない)。
PADDLE_OCR_URL="https://paddle-ocr-whfgr6jwaa-an.a.run.app"

# deploy-functions.ymlのL1ゲート宣言(code-default選択時はこの値を維持する)。
# 2026-09-23/25にcode-defaultデプロイでpaddle→geminiへ無言で回帰した再発防止。
# 変更は別コミット+PRで行うこと(一時的なロールバックはworkflow入力のoverrideを使う)。
OCR_PROVIDER="paddle"

# ADR-0027 PR1c: Sarashina要約Cloud Runサービス。初回デプロイ完了(2026-09-22、
# GitHub Actions run 35674503504、/health・/props(build_info/model_alias一致)・
# image digest一致・生成疎通(実処理2秒)を確認済み)
SARASHINA_SUMMARY_URL="https://sarashina-summary-whfgr6jwaa-an.a.run.app"

# deploy-functions.ymlのL1ゲート宣言(OCR_PROVIDERと同じ扱い)。devは実機観測のため
# sarashinaで稼働中。kanameone/cocoroは宣言なし=コード既定none(PR6でdev以外へ展開する際に別途宣言)。
SUMMARY_PROVIDER="sarashina"
