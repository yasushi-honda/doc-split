# DocSplit クライアント: ココロ
# gcloud config: doc-split-cocoro（サービスアカウント方式）
CLIENT_NAME="cocoro"
PROJECT_ID="docsplit-cocoro"
GCLOUD_CONFIG="doc-split-cocoro"
EXPECTED_ACCOUNT="docsplit-deployer@docsplit-cocoro.iam.gserviceaccount.com"
AUTH_TYPE="service_account"
STORAGE_BUCKET="docsplit-cocoro.appspot.com"

# Issue #445 PR-D4 S1-6: provenance backfill 用設定 (S2 番号認可下で <TBD> を実値に置換)
# workflow yaml の resolve_field() が <TBD> / TBD / 空 を reject するため、
# 未設定状態で誤 dispatch しても artifact bucket 等にアクセスせず早期失敗する
ARTIFACT_BUCKET="<TBD>"
# ADR-0025 PR3(cocoroインフラ準備)実施時にgcloud run services list --project=docsplit-cocoroで
# 実測確認(2026-09-17)。deploy-paddle-ocr.ymlとpr-d4-backfill.ymlの両方が参照する共有フィールド
CLOUD_RUN_LOCATION="asia-northeast1"
BUCKET_LOCATION="<TBD>"

# ADR-0025 PR4b: PaddleOCR Cloud Runサービス。初回デプロイ(deploy-paddle-ocr.yml、
# environment=cocoro / first_deploy=true)実行後、実URLへ更新する
PADDLE_OCR_URL="<TBD>"
