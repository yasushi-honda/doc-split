# DocSplit クライアント: ココロ
# gcloud config: doc-split-cocoro（サービスアカウント方式）
CLIENT_NAME="cocoro"
PROJECT_ID="docsplit-cocoro"
GCLOUD_CONFIG="doc-split-cocoro"
EXPECTED_ACCOUNT="docsplit-deployer@docsplit-cocoro.iam.gserviceaccount.com"
AUTH_TYPE="service_account"
STORAGE_BUCKET="docsplit-cocoro.appspot.com"

# Issue #445 PR-D4 S1-6: provenance backfill 用設定 (S2 番号認可下で <TBD> を実値に置換)
# workflow yaml の resolve_field() が <TBD> / TBD / 空 を reject するため、
# 未設定状態で誤 dispatch しても artifact bucket 等にアクセスせず早期失敗する
ARTIFACT_BUCKET="<TBD>"
# ADR-0025 PR3(cocoroインフラ準備)実施時にgcloud run services list --project=docsplit-cocoroで
# 実測確認(2026-09-17)。deploy-paddle-ocr.ymlとpr-d4-backfill.ymlの両方が参照する共有フィールド
CLOUD_RUN_LOCATION="asia-northeast1"
BUCKET_LOCATION="<TBD>"

# ADR-0025 PR4b: PaddleOCR Cloud Runサービス。初回デプロイ完了(2026-09-17、
# GitHub Actions run 35181045650、golden fixture一致・実処理時間8秒を確認済み)
PADDLE_OCR_URL="https://paddle-ocr-b5erjkokra-an.a.run.app"

# deploy-functions.ymlのL1ゲート宣言(code-default選択時はこの値を維持する)。
# 2026-09-23/25にcode-defaultデプロイでpaddle→geminiへ無言で回帰した再発防止。
# 変更は別コミット+PRで行うこと(一時的なロールバックはworkflow入力のoverrideを使う)。
OCR_PROVIDER="paddle"

# ADR-0027 PR1c: Sarashina要約Cloud Runサービス。初回デプロイ完了(2026-10-06、
# GitHub Actions run 37461387026、revision sarashina-summary-00001-zjg)。
# run.invokerはgenerateSummaryBatchの実行SA(271145290122-compute@)のみ(allUsersなし)。
SARASHINA_SUMMARY_URL="https://sarashina-summary-b5erjkokra-an.a.run.app"

# deploy-functions.ymlのL1ゲート宣言(OCR_PROVIDERと同じ扱い)。
# 2026-10-06: Gemini通常経路停止の環境差解消のためcocoroへSarashinaを展開し、noneからsarashinaへ宣言した。
# 要約は手動依頼(ボタン)でのみ作られ、生成はgenerateSummaryBatch(1分ごと、直列)がSarashinaで実行する。
# L2のallowlist(settings/features.sarashinaSummaryAllowlist)は設定しない(decision-maker判断:
# 最初から全文書へ開放。手動依頼のみで自動生成なし、cocoroの要約利用実績は95日間で0件)。
SUMMARY_PROVIDER="sarashina"
