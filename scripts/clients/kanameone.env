# DocSplit クライアント: カナメワン
# gcloud config: kanameone（Workspaceアカウント方式）
CLIENT_NAME="kanameone"
PROJECT_ID="docsplit-kanameone"
GCLOUD_CONFIG="kanameone"
EXPECTED_ACCOUNT="systemkaname@kanameone.com"
AUTH_TYPE="personal"
STORAGE_BUCKET="docsplit-kanameone.firebasestorage.app"

# Issue #445 PR-D4 S1-6: provenance backfill 用設定 (S2 番号認可下で <TBD> を実値に置換)
# workflow yaml の resolve_field() が <TBD> / TBD / 空 を reject するため、
# 未設定状態で誤 dispatch しても artifact bucket 等にアクセスせず早期失敗する
ARTIFACT_BUCKET="<TBD>"
# ADR-0025 PR3(2026-09-14): kanameoneのPaddleOCR基盤(Artifact Registry/runtime SA)をasia-northeast1に
# 作成済みのため実値化(deploy-paddle-ocr.ymlのCLOUD_RUN_LOCATION解決にも使用、PR-D4と共有フィールド)。
CLOUD_RUN_LOCATION="asia-northeast1"
BUCKET_LOCATION="<TBD>"

# ADR-0025 PR4b: PaddleOCR Cloud Runサービス。2026-09-14 初回デプロイ完了(run 34806152351)。
PADDLE_OCR_URL="https://paddle-ocr-5uv2ktyvhq-an.a.run.app"

# ADR-0027 PR1c: Sarashina要約Cloud Runサービス。PR1bでインフラ準備完了後、
# kanameoneへの初回デプロイ時に実値化する(PADDLE_OCR_URLと同じ運用)。
SARASHINA_SUMMARY_URL="<TBD>"
